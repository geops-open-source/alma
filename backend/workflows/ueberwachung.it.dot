digraph {
  graph [label=< <B>Monitoraggio</B><BR/><BR/> > labelloc=t]
  node [shape=record]

  __START__ [label=< <B>START</B> >]
  __START__ -> start_ueberwachung
  start_ueberwachung [label=< {<B>Monitorare le specifiche separatamente?</B>|[F] Presentazione separata delle specifiche (concetto)?|[F] Il proprietario ha già richiesto di presentare un rapporto? (per esempio al IT)|[D] Richiesta al proprietario|[F] Ricevuto il rapporto richiesto?} >]
  mahnung_uekonzept [label=< {<B>Promemoria per la presentazione del concetto di monitoraggio</B>|[D] Promemoria per il proprietario|[F] Il rapporto richiesto è stato ricevuto dopo il sollecito?} >]
  beurteilung_uekonzept [label=< {<B>Valutazione del concetto di monitoraggio</B>|[D] Proprietario del rapporto|[F] Se il rapporto presentato è incompleto, sono necessarie ulteriori richieste?|[F] Se il rapporto presentato è incompleto, sono necessarie ulteriori richieste?} >]
  uekonzept_nachforderung [label=< {<B>Richiesta di follow-up per il concetto di monitoraggio</B>|[D] Richiesta al proprietario|[F] Il proprietario ha presentato i documenti richiesti?|[D] Proprietario del rapporto|[F] Valutazione completata?} >]
  uekonzept_anhoerung_kanton [label=< {<B>Concetto di monitoraggio Consultazione cantonale</B>|[D] Lettera di presentazione Audizione|[F] Attendere la dichiarazione} >]
  stellungnahme_uekonzept [label=< {<B>Risposta alla consultazione cantonale</B>|[D] Dichiarazione cantonale|[F] Influenza della dichiarazione del Cantone sul concetto di monitoraggio|[D] Risposta alla dichiarazione|[F] Registrazione dei documenti} >]
  uekonzept_anhoerung_inhaber [label=< {<B>Concetto di monitoraggio Consultazione con il proprietario</B>|[D] Dichiarazione definitiva|[F] Attendere la dichiarazione} >]
  stellungnahme_uekonzept_inhaber [label=< {<B>Risposta del proprietario</B>|[D] Proprietario della dichiarazione|[F] Influenza Dichiarazione del proprietario sul concetto di monitoraggio|[D] Risposta alla dichiarazione|[F] Registrazione dei documenti} >]
  ueberwachung_freigabe [label=< {<B>Monitoraggio del rilascio</B>|[F] Se emergono nuovi risultati dalle indagini/campionamenti nell'ambito del monitoraggio: Cosa succede dopo?|[F] Il concetto è approvato?} >]
  ueberwachung_zwischenbericht [label=< {<B>Monitoraggio delle relazioni intermedie</B>|[F] Il proprietario deve presentare relazioni di monitoraggio intermedie?|[D] Proprietario del rapporto|[F] Valutazione del sito dopo il monitoraggio:|[F] Registrazione dei documenti} >]
  zwischenbericht_mahnung [label=< {<B>Promemoria per la presentazione delle relazioni intermedie</B>|[D] Promemoria per il proprietario|[F] Rapporto: presentazione effettuata dopo il sollecito?} >]
  uebericht [label=< {<B>Rapporto di monitoraggio</B>|[F] Il proprietario ha già richiesto di presentare un rapporto? (per esempio al IT)|[D] Richiesta al proprietario|[F] Rapporto richiesto ricevuto:} >]
  uebericht_mahnung [label=< {<B>Promemoria per la presentazione del rapporto di monitoraggio</B>|[D] Promemoria per il proprietario|[F] Il rapporto richiesto è stato ricevuto dopo il sollecito?} >]
  uebericht_beurteilung [label=< {<B>Valutazione del rapporto di monitoraggio</B>|[D] Proprietario del rapporto|[F] È disponibile una valutazione cantonale?|[D] Dichiarazione cantonale Rapporto di monitoraggio|[F] L'Ufficio commenterà la relazione presentata?|[F] Se il rapporto presentato è incompleto, sono necessarie ulteriori richieste?|[F] Valutazione completata?} >]
  uebericht_nachforderung [label=< {<B>Richiesta di follow-up per la relazione di monitoraggio</B>|[D] Richiesta al proprietario|[F] Il proprietario ha presentato i documenti richiesti?|[D] Proprietario del rapporto|[F] Valutazione completata?} >]
  uebericht_anhoerung_kanton [label=< {<B>Rapporto di monitoraggio Cantone di consultazione</B>|[D] Lettera di presentazione Audizione|[F] Attendere la dichiarazione} >]
  stellungnahme_uebericht [label=< {<B>Risposta alla consultazione cantonale</B>|[D] Dichiarazione cantonale|[F] Influenza della dichiarazione del Cantone sul concetto di monitoraggio|[D] Risposta alla dichiarazione|[F] Registrazione dei documenti} >]
  uebericht_anhoerung_inhaber [label=< {<B>Concetto di monitoraggio Consultazione con il proprietario</B>|[D] Dichiarazione definitiva|[F] Attendere la dichiarazione} >]
  stellungnahme_uebericht_inhaber [label=< {<B>Risposta del proprietario</B>|[D] Proprietario della dichiarazione|[F] Influenza Dichiarazione del proprietario sul concetto di monitoraggio|[D] Risposta alla dichiarazione|[F] Registrazione dei documenti} >]
  neubeurteilung [label=< {<B>Rivalutazione dovuta al monitoraggio</B>|[F] Valutazione del sito dopo il monitoraggio:} >]
  abschluss_ueberwachung [label=< {<B>Finalizzazione Monitoraggio</B>|[F] La posizione non deve più essere monitorata: } >]
  END [label=< {<B>__END__</B>} >]

  start_ueberwachung -> beurteilung_uekonzept [label="form\n.entscheid_bericht\n.entscheid_bericht_erfasst == `ja`" fontsize=10]
  start_ueberwachung -> mahnung_uekonzept [label="form\n.entscheid_bericht\n.entscheid_bericht_erfasst == `nein`" fontsize=10]
  start_ueberwachung -> ueberwachung_freigabe [label="form\n.entscheid_konzept_separat\n.entscheid_konzept_separat_erfasst == `ja`" fontsize=10]
  mahnung_uekonzept -> beurteilung_uekonzept [label="form\n.entscheid_bericht_mahnung_uekonzept\n.entscheid_bericht_mahnung_uekonzept_erfasst == `ja`" fontsize=10]
  mahnung_uekonzept -> mahnung_uekonzept [label="form\n.entscheid_bericht_mahnung_uekonzept\n.entscheid_bericht_mahnung_uekonzept_erfasst == `nein`" fontsize=10]
  beurteilung_uekonzept -> uekonzept_anhoerung_kanton [label="form\n.entscheid_bericht_uekonzept_vollstaendig\n.entscheid_bericht_uekonzept_vollstaendig_erfasst == `ok`" fontsize=10]
  beurteilung_uekonzept -> uekonzept_nachforderung [label="form\n.entscheid_bericht_uekonzept_vollstaendig\n.entscheid_bericht_uekonzept_vollstaendig_erfasst == `nachforderung`" fontsize=10]
  uekonzept_nachforderung -> mahnung_uekonzept [label="form\n.entscheid_nachforderungen_vollstaendig\n.entscheid_nachforderungen_vollstaendig_erfasst == `keine`" fontsize=10]
  uekonzept_nachforderung -> uekonzept_nachforderung [label="form\n.entscheid_nachforderungen_vollstaendig\n.entscheid_nachforderungen_vollstaendig_erfasst == `nein`" fontsize=10]
  uekonzept_nachforderung -> uekonzept_anhoerung_kanton [label="form\n.entscheid_nachforderungen_vollstaendig\n.entscheid_nachforderungen_vollstaendig_erfasst == `ja` || form\n.entscheid_nachforderungen_vollstaendig\n.entscheid_nachforderungen_vollstaendig_erfasst == `verzicht'" fontsize=10]
  uekonzept_anhoerung_kanton -> stellungnahme_uekonzept [label="form\n.entscheid_stellungnahme_uekonzept\n.entscheid_stellungnahme_uekonzept_erfasst == `ja`" fontsize=10]
  uekonzept_anhoerung_kanton -> uekonzept_anhoerung_inhaber [label="form\n.entscheid_stellungnahme_uekonzept\n.entscheid_stellungnahme_uekonzept_erfasst == `nein`" fontsize=10]
  stellungnahme_uekonzept -> stellungnahme_uekonzept [label="form\n.entscheid_dokumente_uekonzept_stellungnahme\n.entscheid_dokumente_uekonzept_stellungnahme_erfasst == `keine`" fontsize=10]
  stellungnahme_uekonzept -> uekonzept_anhoerung_inhaber [label="form\n.entscheid_dokumente_uekonzept_stellungnahme\n.entscheid_dokumente_uekonzept_stellungnahme_erfasst == `abgelehnt` || form\n.entscheid_dokumente_uekonzept_stellungnahme\n.entscheid_dokumente_uekonzept_stellungnahme_erfasst == `einverstanden`" fontsize=10]
  stellungnahme_uekonzept -> beurteilung_uekonzept [label="form\n.entscheid_dokumente_uekonzept_stellungnahme\n.entscheid_dokumente_uekonzept_stellungnahme_erfasst == `neubeurteilung`" fontsize=10]
  uekonzept_anhoerung_inhaber -> stellungnahme_uekonzept_inhaber [label="form\n.entscheid_stellungnahme_uekonzept_inhaber\n.entscheid_stellungnahme_uekonzept_inhaber_erfasst == `ja`" fontsize=10]
  uekonzept_anhoerung_inhaber -> ueberwachung_freigabe [label="form\n.entscheid_stellungnahme_uekonzept_inhaber\n.entscheid_stellungnahme_uekonzept_inhaber_erfasst == `nein`" fontsize=10]
  stellungnahme_uekonzept_inhaber -> ueberwachung_freigabe [label="form\n.entscheid_dokumente_uekonzept_stellungnahme_inhaber\n.entscheid_dokumente_uekonzept_stellungnahme_inhaber_erfasst == `abgelehnt` || form\n.entscheid_dokumente_uekonzept_stellungnahme_inhaber\n.entscheid_dokumente_uekonzept_stellungnahme_inhaber_erfasst == `einverstanden`" fontsize=10]
  stellungnahme_uekonzept_inhaber -> beurteilung_uekonzept [label="form\n.entscheid_dokumente_uekonzept_stellungnahme_inhaber\n.entscheid_dokumente_uekonzept_stellungnahme_inhaber_erfasst == `neubeurteilung`" fontsize=10]
  stellungnahme_uekonzept_inhaber -> stellungnahme_uekonzept_inhaber [label="form\n.entscheid_dokumente_uekonzept_stellungnahme_inhaber\n.entscheid_dokumente_uekonzept_stellungnahme_inhaber_erfasst == `keine`" fontsize=10]
  ueberwachung_freigabe -> ueberwachung_zwischenbericht [label="form\n.entscheid_konzept_freigabe\n.entscheid_konzept_freigabe_erfasst == `ja`" fontsize=10]
  ueberwachung_freigabe -> END [label="form\n.entscheid_konzept_freigabe\n.entscheid_konzept_freigabe_erfasst == `nein`" fontsize=10]
  ueberwachung_zwischenbericht -> uebericht [label="form\n.entscheid_zwischenberichte\n.entscheid_zwischenberichte_erfasst != `ausstehend` && form\n.entscheid_zwischenbericht_beurteilung\n.entscheid_zwischenbericht_beurteilung_erfasst == `weiter`" fontsize=10]
  ueberwachung_zwischenbericht -> zwischenbericht_mahnung [label="form\n.entscheid_zwischenberichte\n.entscheid_zwischenberichte_erfasst == `ausstehend` && form\n.entscheid_zwischenbericht_beurteilung\n.entscheid_zwischenbericht_beurteilung_erfasst == `weiter`" fontsize=10]
  ueberwachung_zwischenbericht -> END [label="form\n.entscheid_zwischenbericht_beurteilung\n.entscheid_zwischenbericht_beurteilung_erfasst == `ende`" fontsize=10]
  zwischenbericht_mahnung -> ueberwachung_zwischenbericht [label="form\n.entscheid_bericht_mahnung\n.entscheid_bericht_mahnung_erfasst == `ja`" fontsize=10]
  zwischenbericht_mahnung -> zwischenbericht_mahnung [label="form\n.entscheid_bericht_mahnung\n.entscheid_bericht_mahnung_erfasst == `nein`" fontsize=10]
  uebericht -> uebericht_beurteilung [label="form\n.entscheid_uebericht_erhalten\n.entscheid_uebericht_erhalten_erfasst == `ja`" fontsize=10]
  uebericht -> uebericht_mahnung [label="form\n.entscheid_uebericht_erhalten\n.entscheid_uebericht_erhalten_erfasst == `nein`" fontsize=10]
  uebericht_mahnung -> uebericht_beurteilung [label="form\n.entscheid_uebericht_mahnung\n.entscheid_uebericht_mahnung_erfasst == `ja`" fontsize=10]
  uebericht_mahnung -> uebericht_mahnung [label="form\n.entscheid_uebericht_mahnung\n.entscheid_uebericht_mahnung_erfasst == `nein`" fontsize=10]
  uebericht_beurteilung -> uebericht_nachforderung [label="form\n.entscheid_bericht_nachforderung\n.entscheid_bericht_nachforderung_erfasst == `ja`" fontsize=10]
  uebericht_beurteilung -> uebericht_anhoerung_kanton [label="form\n.entscheid_bericht_vollstaendig\n.entscheid_bericht_vollstaendig_erfasst == `jetzt`" fontsize=10]
  uebericht_beurteilung -> neubeurteilung [label="form\n.entscheid_bericht_vollstaendig\n.entscheid_bericht_vollstaendig_erfasst == `spaeter`" fontsize=10]
  uebericht_nachforderung -> uebericht_mahnung [label="form\n.entscheid_nachforderungen_uebericht_vollstaendig\n.entscheid_nachforderungen_uebericht_vollstaendig_erfasst == `keine`" fontsize=10]
  uebericht_nachforderung -> uebericht_nachforderung [label="form\n.entscheid_nachforderungen_uebericht_vollstaendig\n.entscheid_nachforderungen_uebericht_vollstaendig_erfasst == `nein`" fontsize=10]
  uebericht_nachforderung -> uebericht_anhoerung_kanton [label="form\n.entscheid_nachforderungen_uebericht_vollstaendig\n.entscheid_nachforderungen_uebericht_vollstaendig_erfasst == `ja` || form\n.entscheid_nachforderungen_uebericht_vollstaendig\n.entscheid_nachforderungen_uebericht_vollstaendig_erfasst == `verzicht'" fontsize=10]
  uebericht_anhoerung_kanton -> stellungnahme_uebericht [label="form\n.entscheid_stellungnahme_uebericht\n.entscheid_stellungnahme_uebericht_erfasst == `ja`" fontsize=10]
  uebericht_anhoerung_kanton -> uebericht_anhoerung_inhaber [label="form\n.entscheid_stellungnahme_uebericht\n.entscheid_stellungnahme_uebericht_erfasst == `nein`" fontsize=10]
  stellungnahme_uebericht -> stellungnahme_uebericht [label="form\n.entscheid_dokumente_stellungnahme\n.entscheid_dokumente_stellungnahme_erfasst == `keine`" fontsize=10]
  stellungnahme_uebericht -> uebericht_anhoerung_inhaber [label="form\n.entscheid_dokumente_stellungnahme\n.entscheid_dokumente_stellungnahme_erfasst == `abgelehnt` || form\n.entscheid_dokumente_stellungnahme\n.entscheid_dokumente_stellungnahme_erfasst == `einverstanden`" fontsize=10]
  stellungnahme_uebericht -> uebericht_beurteilung [label="form\n.entscheid_dokumente_stellungnahme\n.entscheid_dokumente_stellungnahme_erfasst == `neubeurteilung`" fontsize=10]
  uebericht_anhoerung_inhaber -> stellungnahme_uebericht_inhaber [label="form\n.entscheid_stellungnahme_uebericht_inhaber\n.entscheid_stellungnahme_uebericht_inhaber_erfasst == `ja`" fontsize=10]
  uebericht_anhoerung_inhaber -> neubeurteilung [label="form\n.entscheid_stellungnahme_uebericht_inhaber\n.entscheid_stellungnahme_uebericht_inhaber_erfasst == `nein`" fontsize=10]
  stellungnahme_uebericht_inhaber -> neubeurteilung [label="form\n.entscheid_dokumente_stellungnahme_inhaber\n.entscheid_dokumente_stellungnahme_inhaber_erfasst == `abgelehnt` || form\n.entscheid_dokumente_stellungnahme_inhaber\n.entscheid_dokumente_stellungnahme_inhaber_erfasst == `einverstanden`" fontsize=10]
  stellungnahme_uebericht_inhaber -> uebericht_beurteilung [label="form\n.entscheid_dokumente_stellungnahme_inhaber\n.entscheid_dokumente_stellungnahme_inhaber_erfasst == `neubeurteilung`" fontsize=10]
  stellungnahme_uebericht_inhaber -> stellungnahme_uebericht_inhaber [label="form\n.entscheid_dokumente_stellungnahme_inhaber\n.entscheid_dokumente_stellungnahme_inhaber_erfasst == `keine`" fontsize=10]
  neubeurteilung -> start_ueberwachung [label="form\n.entscheid_beurteilung\n.entscheid_beurteilung_erfasst == `konzept`" fontsize=10]
  neubeurteilung -> ueberwachung_freigabe [label="form\n.entscheid_beurteilung\n.entscheid_beurteilung_erfasst == `weiter`" fontsize=10]
  neubeurteilung -> abschluss_ueberwachung [label="form\n.entscheid_beurteilung\n.entscheid_beurteilung_erfasst == `abschluss`" fontsize=10]
  abschluss_ueberwachung -> END [label="" fontsize=10]
}
