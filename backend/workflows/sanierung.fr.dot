  du_pflichtenheft_anhoerung_inhaber -> du_pflichtenheft_beurteilung [label="form\n.eingang_stellungnahme\n.anhoerung_stellungnahme_eingetroffen == `ja`" fontsize=10]
  detailuntersuchung_freigabe_durch -> detailuntersuchung_laeuft [label="" fontsize=10]
  sanierung_start_sanierungsprojekt -> sanierungsprojekt_beurteilung [label="form\n.einreichen_bericht_inhaber\n.fristgerechte_einreichung == `ja`" fontsize=10]
  sanierung_start_sanierungsprojekt -> sanierungsprojekt_mahnung_zur_einreichung [label="form\n.einreichen_bericht_inhaber\n.fristgerechte_einreichung == `nein`" fontsize=10]
  detailuntersuchung_schlussbericht_mahnung -> detailuntersuchung_schlussbericht_beurteilung [label="form\n.bericht\n.eingang_mahnung == `ja`" fontsize=10]
  detailuntersuchung_schlussbericht_mahnung -> detailuntersuchung_schlussbericht_mahnung [label="form\n.bericht\n.eingang_mahnung == `nein`" fontsize=10]
  start_ergaenzende_du -> ergaenzende_du_pflichtenheft [label="form\n.sanierungsuntersuchung\n.pflichtenheft_status == `fehlt`" fontsize=10]
  start_ergaenzende_du -> ergaenzende_du_pflichtenheft_beurteilung [label="form\n.sanierungsuntersuchung\n.pflichtenheft_status == `beurteilen`" fontsize=10]
  start_ergaenzende_du -> ergaenzende_du_freigabe_durch [label="form\n.sanierungsuntersuchung\n.pflichtenheft_status == `enthalten`" fontsize=10]
  erg_du_pflichtenheft_mahnung_bericht -> ergaenzende_du_pflichtenheft_beurteilung [label="form\n.reaktion_inhaber\n.eingang_bericht == `ja`" fontsize=10]
  erg_du_pflichtenheft_mahnung_bericht -> erg_du_pflichtenheft_mahnung_bericht [label="form\n.reaktion_inhaber\n.eingang_bericht == `nein`" fontsize=10]
  ergaenzende_du_pflichtenheft -> ergaenzende_du_pflichtenheft_beurteilung [label="form\n.einreichung_bericht\n.fristgerecht_eingereicht == `ja`" fontsize=10]
  ergaenzende_du_pflichtenheft -> erg_du_pflichtenheft_mahnung_bericht [label="form\n.einreichung_bericht\n.fristgerecht_eingereicht == `nein`" fontsize=10]
  ergaenzende_du_pflichtenheft_beurteilung -> ergaenzende_du_pflichtenheft_anhoerung_inhaber [label="" fontsize=10]
  ergaenzende_du_pflichtenheft_anhoerung_inhaber -> ergaenzende_du_freigabe_durch [label="" fontsize=10]
  ergaenzende_du_freigabe_durch -> ergaenzende_detailuntersuchung_lauft [label="" fontsize=10]
  ergaenzende_detailuntersuchung_lauft -> erg_detailuntersuchung_schlussbericht_beurteilung [label="" fontsize=10]
  erg_detailuntersuchung_schlussbericht_beurteilung -> END [label="form\n.erg_detailuntersuchung_schlussbericht_beurteilung__neubeurteilung\n.erg_detailuntersuchung_schlussbericht_beurteilung__abbruch == `ja`" fontsize=10]
  erg_detailuntersuchung_schlussbericht_beurteilung -> sanierung_start_sanierungsprojekt [label="form\n.erg_detailuntersuchung_schlussbericht_beurteilung__neubeurteilung\n.erg_detailuntersuchung_schlussbericht_beurteilung__abbruch == `nein`" fontsize=10]
  sanierungsprojekt_mahnung_zur_einreichung -> sanierungsprojekt_beurteilung [label="form\n.sanierungsprojekt_mahnung_zur_einreichung__mahnung\n.sanierungsprojekt_mahnung_zur_einreichung__bericht_eingereicht == `ja`" fontsize=10]
  sanierungsprojekt_mahnung_zur_einreichung -> sanierungsprojekt_mahnung_zur_einreichung [label="form\n.sanierungsprojekt_mahnung_zur_einreichung__mahnung\n.sanierungsprojekt_mahnung_zur_einreichung__bericht_eingereicht == `nein`" fontsize=10]
  sanierungsprojekt_beurteilung -> sanierungsprojekt_anhoerung_kanton [label="" fontsize=10]
  sanierungsprojekt_anhoerung_kanton -> sanierungsprojekt_anhoerung_inhaber [label="" fontsize=10]
