  standortsanierung_freigabe_durch -> standortsanierung_laeuft_zwischenbericht [label="" fontsize=10]
  standortsanierung_laeuft_zwischenbericht -> standortsanierung_laeuft_beurteilung_zwischenbericht [label="form\n.standortsanierung_laeuft_zwischenbericht__einreichung\n.standortsanierung_laeuft_zwischenbericht__fristgerecht == `ja`" fontsize=10]
  standortsanierung_laeuft_zwischenbericht -> standortsanierung_lauft [label="form\n.standortsanierung_laeuft_zwischenbericht__einreichung\n.standortsanierung_laeuft_zwischenbericht__fristgerecht == `nichtnoetig`" fontsize=10]
  standortsanierung_laeuft_mahnung_bericht -> standortsanierung_laeuft_mahnung_bericht [label="form\n.standortsanierung_laeuft_mahnung_bericht__brief\n.standortsanierung_laeuft_mahnung_bericht__brief_eingereicht == `nein`" fontsize=10]
  standortsanierung_laeuft_mahnung_bericht -> standortsanierung_laeuft_beurteilung_zwischenbericht [label="form\n.standortsanierung_laeuft_mahnung_bericht__brief\n.standortsanierung_laeuft_mahnung_bericht__brief_eingereicht == `ja`" fontsize=10]
  standortsanierung_laeuft_beurteilung_zwischenbericht -> standortsanierung_laeuft_zwischenbericht [label="" fontsize=10]
  standortsanierung_lauft -> erfolgskontrolle [label="" fontsize=10]
  erfolgskontrolle -> erfolgskontrolle_beurteilung_schlussbericht [label="form\n.erfolgskontrolle__neubeurteilung\n.erfolgskontrolle__bericht == `fehlt`" fontsize=10]
  erfolgskontrolle -> erfolgskontrolle_mahnung_schlussbericht [label="form\n.erfolgskontrolle__neubeurteilung\n.erfolgskontrolle__bericht != `fehlt`" fontsize=10]
  erfolgskontrolle_mahnung_schlussbericht -> erfolgskontrolle_beurteilung_schlussbericht [label="form\n.erfolgskontrolle_mahnung_schlussbericht__inhaber_reaktion\n.erfolgskontrolle_mahnung_schlussbericht__eingereicht == `ja`" fontsize=10]
  erfolgskontrolle_mahnung_schlussbericht -> erfolgskontrolle_mahnung_schlussbericht [label="form\n.erfolgskontrolle_mahnung_schlussbericht__inhaber_reaktion\n.erfolgskontrolle_mahnung_schlussbericht__eingereicht == `nein`" fontsize=10]
  erfolgskontrolle_beurteilung_schlussbericht -> erfolgskontrolle_anhoerung_inhaber [label="form\n.erfolgskontrolle_beurteilung_schlussbericht__stn\n.erfolgskontrolle_beurteilung_schlussbericht__stn == `erfolgskontrolle`" fontsize=10]
