digraph {
  graph [label=< <B>Rénovation</B><BR/><BR/> > labelloc=t]
  node [shape=record]

  __START__ [label=< <B>START</B> >]
  __START__ -> start_sanierung
  start_sanierung [label=< {<B>Début de la rénovation</B>|[F] Examens supplémentaires?|[F] Appel à propositions|[F] Cahier des charges disponible?|[F] Soumission du rapport par le propriétaire} >]
  detailuntersuchung_laeuft [label=< {<B>Enquête détaillée en cours</B>|[F] Clôture de l'étape d'investigation?} >]
  detailuntersuchung_schlussbericht [label=< {<B>Enquête détaillée Rapport final</B>|[F] Appel à propositions|[D] Lettre - Invitation à soumettre un rapport|[F] Soumission du rapport par le propriétaire} >]
  detailuntersuchung_schlussbericht_beurteilung [label=< {<B>Enquête détaillée Rapport final - évaluation</B>|[D] Rapport du propriétaire|[F] Prise de position pertinente du canton?|[D] Prise de position du canton|[F] Évaluation terminée?|[F] Réévaluation du site nécessaire|[F] Examen détaillé complémentaire} >]
  du_pflichtenheft_mahnung [label=< {<B>ED Cahier des charges - Rappel de dépôt</B>|[D] Lettre - rappel aux titulaires|[F] Réaction du propriétaire au rappel} >]
  du_pflichtenheft_beurteilung [label=< {<B>ED Cahier des charges - évaluation</B>|[D] Cahier des charges du propriétaire|[F] Prise de position pertinente du canton?|[D] Prise de position du canton|[F] Évaluation dterminée ?|[F] Evaluation de l'envoi - lettre complète ?} >]
  END [label=< {<B>__END__</B>} >]
  du_pflichtenheft_anhoerung_inhaber [label=< {<B>ED Cahier des charges - Audition du propriétaire</B>|[D] Lettre - Prise de position définitive|[F] Attendre la réception de la prise de position|[D] Prise de position du propriétaire *|[F] Influence Prise de position *|[D] Réponse à la prise de position *|[F] Enregistrement du document *} >]
  detailuntersuchung_freigabe_durch [label=< {<B>Examen détaillé - validation</B>|[F] Cahier des charges approuvé} >]
  sanierung_start_sanierungsprojekt [label=< {<B>Rénovation - Lancement du projet de rénovation</B>|[F] Appel à propositions|[D] Lettre - Invitation à soumettre un rapport|[F] Soumission du rapport par le propriétaire} >]
  detailuntersuchung_schlussbericht_mahnung [label=< {<B>Enquête détaillée Rapport final - Rappel Rapport</B>|[D] Lettre - rappel aux propriétaires|[F] Réaction du propriétaire au rappel} >]
  start_ergaenzende_du [label=< {<B>Démarrage ED complémentaire</B>|[F] Enquête sur la rénovation|[D] Cahier des charges du propriétaire} >]
  erg_du_pflichtenheft_mahnung_bericht [label=< {<B>Complément ED cahier des charges - rappel rapport</B>|[D] Lettre - rappel aux propriétaires|[F] Réaction du propriétaire au rappel} >]
  ergaenzende_du_pflichtenheft [label=< {<B>ED complémentaire - Cahier des charges</B>|[F] Appel à propositions|[D] Lettre - Invitation à remettre le rapport|[F] Soumission du rapport par le propriétaire} >]
  ergaenzende_du_pflichtenheft_beurteilung [label=< {<B>ED complémentaire Cahier des charges - Evaluation</B>|[D] Cahier des charges du propriétaire|[F] Prise de position pertinente du canton?|[D] Prise de position du canton|[F] Évaluation terminée ?} >]
  ergaenzende_du_pflichtenheft_anhoerung_inhaber [label=< {<B>ED complémentaire Cahier des charges - Consultation du propriétaire</B>|[D] Lettre - Prise de position définitive|[F] Attendre la réception de la prise de position|[D] Prise de position du propriétaire|[F] Influence Prise de position|[D] Réponse à la prise de position|[F] Enregistrement du document} >]
  ergaenzende_du_freigabe_durch [label=< {<B>ED complémentaire - Validation</B>|[F] Cahier des charges approuvé} >]
  ergaenzende_detailuntersuchung_lauft [label=< {<B>Enquête détaillée complémentaire en cours</B>|[F] Clôture de l'étape d'investigation?} >]
  erg_detailuntersuchung_schlussbericht_beurteilung [label=< {<B>Enquête détaillée complémentaire Rapport final - évaluation</B>|[D] Rapport final Propriétaire|[F] Prise de position pertinente du canton?|[D] Prise de position du canton|[F] Évaluation terminée ?|[F] Réévaluation du site nécessaire} >]
  sanierungsprojekt_mahnung_zur_einreichung [label=< {<B>Projet de rénovation - rappel pour soumission</B>|[D] Lettre - rappel aux propriétaires|[F] Réaction du propriétaire au rappel} >]
  sanierungsprojekt_beurteilung [label=< {<B>Projet de rénovation - évaluation</B>|[D] Rapport du propriétaire|[F] Prise de position pertinente du canton?|[D] Prise de position du canton|[F] Évaluation terminée ?|[F] Evaluation de l'envoi - lettre complète ?} >]
  sanierungsprojekt_anhoerung_kanton [label=< {<B>Projet de rénovation - consultation du canton</B>|[D] Lettre - lettre d'accompagnement audition autorité|[F] Attendre la réception de la prise de position|[D] Prise de position du canton|[F] Influence Prise de position|[D] Réponse à la prise de position|[F] Enregistrement du document} >]
  sanierungsprojekt_anhoerung_inhaber [label=< {<B>Projet de rénovation - consultation des propriétaires</B>|[D] Lettre - Prise de position définitive|[F] Attendre la réception de la prise de position|[D] Prise de position du propriétaire|[F] Influence Prise de position|[D] Réponse à la prise de position|[F] Enregistrement du document} >]
  standortsanierung_freigabe_durch [label=< {<B>Assainissement du site - autorisation</B>|[F] Cahier des charges approuvé} >]
  standortsanierung_laeuft_zwischenbericht [label=< {<B>Assainissement du site en cours - rapport intermédiaire</B>|[F] Rapports intermédiaires?|[D] Rapport du propriétaire|[D] Demande de rapport au propriétaire|[F] Enregistrement du document} >]
  standortsanierung_laeuft_mahnung_bericht [label=< {<B>Rénovation du site en cours - Rapport d'avertissement</B>|[D] Lettre - rappel aux propriétaires|[F] Réaction du propriétaire au rappel} >]
  standortsanierung_laeuft_beurteilung_zwischenbericht [label=< {<B>Rénovation du site en cours - évaluation du rapport intermédiaire</B>|[F] Prise de position nécessaire?|[F] Evaluation de l'envoi - lettre complète ?|[D] Lettre - Prise de position définitive|[F] Enregistrement du document} >]
  standortsanierung_lauft [label=< {<B>Rénovation du site en cours</B>|[F] Clôture de l'étape d'investigation?} >]
  erfolgskontrolle [label=< {<B>Contrôle des résultats</B>|[F] Rapport de réévaluation après rénovation|[D] Rapport final Propriétaire|[F] Enregistrement du document} >]
  erfolgskontrolle_mahnung_schlussbericht [label=< {<B>Contrôle des résultats - Rappel Rapport final</B>|[D] Lettre - rappel aux propriétaires|[F] Réaction du propriétaire au rappel|[D] Rapport final Propriétaire|[F] Enregistrement du document} >]
  erfolgskontrolle_beurteilung_schlussbericht [label=< {<B>Contrôle des résultats - Évaluation Rapport final</B>|[F] Prise de position pertinente du canton?|[D] Prise de position du canton|[F] Évaluation terminée ?|[F] Prise de position sur le contrôle des résultats ou la réévaluation ?|[F] Evaluation de l'envoi - lettre complète ?} >]
  erfolgskontrolle_anhoerung_inhaber [label=< {<B>Contrôle des résultats - Audition du propriétaire</B>|[D] Lettre - Prise de position définitive|[F] Attendre la réception de la prise de position|[D] Prise de position du propriétaire|[F] Influence Prise de position|[D] Réponse à la prise de position|[F] Enregistrement du document} >]
  sanierung_ende [label=< {<B>Fin de la rénovation</B>|[F] Fin de la rénovation - Réévaluation acceptée par le propriétaire|[F] Inscription dans la liste des sites assainis de l'OFEV} >]

  start_sanierung -> detailuntersuchung_laeuft [label="form\n.pflichtenheft\n.pflichtenheft_noetig == `nein`" fontsize=10]
  start_sanierung -> du_pflichtenheft_mahnung [label="form\n.start_sanierung__einreichen_brief\n.bericht_eingereicht == `nein`" fontsize=10]
  start_sanierung -> detailuntersuchung_schlussbericht [label="form\n.zusatz_untersuchungen\n.zusatz_untersuchungen_noetig == `varianten`" fontsize=10]
  start_sanierung -> sanierung_start_sanierungsprojekt [label="form\n.zusatz_untersuchungen\n.zusatz_untersuchungen_noetig == `nein`" fontsize=10]
  start_sanierung -> du_pflichtenheft_beurteilung [label="form\n.start_sanierung__einreichen_brief\n.bericht_eingereicht == `ja`" fontsize=10]
  detailuntersuchung_laeuft -> detailuntersuchung_schlussbericht [label="" fontsize=10]
  detailuntersuchung_schlussbericht -> detailuntersuchung_schlussbericht_beurteilung [label="form\n.detailuntersuchung_schlussbericht__einreichen_brief\n.bericht_eingereicht == `ja`" fontsize=10]
  detailuntersuchung_schlussbericht -> detailuntersuchung_schlussbericht_mahnung [label="form\n.detailuntersuchung_schlussbericht__einreichen_brief\n.bericht_eingereicht == `nein`" fontsize=10]
  detailuntersuchung_schlussbericht_beurteilung -> END [label="form\n.neubeurteilung\n.neubeurteilung_noetig == `ja`" fontsize=10]
  detailuntersuchung_schlussbericht_beurteilung -> start_ergaenzende_du [label="" fontsize=10]
  detailuntersuchung_schlussbericht_beurteilung -> sanierung_start_sanierungsprojekt [label="" fontsize=10]
  du_pflichtenheft_mahnung -> du_pflichtenheft_beurteilung [label="form\n.reaktion_inhaber_mahnung\n.bericht_mittlerweile_eingereicht == `ja`" fontsize=10]
  du_pflichtenheft_mahnung -> du_pflichtenheft_mahnung [label="form\n.reaktion_inhaber_mahnung\n.bericht_mittlerweile_eingereicht == `nein`" fontsize=10]
  du_pflichtenheft_beurteilung -> du_pflichtenheft_anhoerung_inhaber [label="" fontsize=10]
