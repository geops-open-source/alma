  standortsanierung_laeuft_zwischenbericht -> standortsanierung_laeuft_beurteilung_zwischenbericht [label="form\n.standortsanierung_laeuft_zwischenbericht__einreichung\n.standortsanierung_laeuft_zwischenbericht__fristgerecht == `ja`" fontsize=10]
  standortsanierung_laeuft_zwischenbericht -> standortsanierung_lauft [label="form\n.standortsanierung_laeuft_zwischenbericht__einreichung\n.standortsanierung_laeuft_zwischenbericht__fristgerecht == `nichtnoetig`" fontsize=10]
  standortsanierung_laeuft_mahnung_bericht -> standortsanierung_laeuft_mahnung_bericht [label="form\n.standortsanierung_laeuft_mahnung_bericht__brief\n.standortsanierung_laeuft_mahnung_bericht__brief_eingereicht == `nein`" fontsize=10]
  standortsanierung_laeuft_mahnung_bericht -> standortsanierung_laeuft_beurteilung_zwischenbericht [label="form\n.standortsanierung_laeuft_mahnung_bericht__brief\n.standortsanierung_laeuft_mahnung_bericht__brief_eingereicht == `ja`" fontsize=10]
  standortsanierung_laeuft_beurteilung_zwischenbericht -> standortsanierung_laeuft_zwischenbericht [label="" fontsize=10]
