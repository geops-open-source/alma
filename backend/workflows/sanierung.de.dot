  detailuntersuchung_schlussbericht -> detailuntersuchung_schlussbericht_beurteilung [label="form\n.detailuntersuchung_schlussbericht__einreichen_brief\n.bericht_eingereicht == `ja`" fontsize=10]
  detailuntersuchung_schlussbericht -> detailuntersuchung_schlussbericht_mahnung [label="form\n.detailuntersuchung_schlussbericht__einreichen_brief\n.bericht_eingereicht == `nein`" fontsize=10]
  detailuntersuchung_schlussbericht_beurteilung -> END [label="form\n.neubeurteilung\n.neubeurteilung_noetig == `ja`" fontsize=10]
  detailuntersuchung_schlussbericht_beurteilung -> start_ergaenzende_du [label="" fontsize=10]
  detailuntersuchung_schlussbericht_beurteilung -> sanierung_start_sanierungsprojekt [label="" fontsize=10]
  du_pflichtenheft_mahnung -> du_pflichtenheft_beurteilung [label="form\n.reaktion_inhaber_mahnung\n.bericht_mittlerweile_eingereicht == `ja`" fontsize=10]
  du_pflichtenheft_mahnung -> du_pflichtenheft_mahnung [label="form\n.reaktion_inhaber_mahnung\n.bericht_mittlerweile_eingereicht == `nein`" fontsize=10]
  du_pflichtenheft_beurteilung -> du_pflichtenheft_anhoerung_inhaber [label="" fontsize=10]
