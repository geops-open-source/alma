digraph {
  graph [label=< <B>Sanierung</B><BR/><BR/> > labelloc=t]
  node [shape=record]

  __START__ [label=< <B>START</B> >]
  __START__ -> start_sanierung
  start_sanierung [label=< {<B>Start Sanierung</B>|[F] Zusätzliche Untersuchungen?|[F] Aufforderung zur Einreichung|[F] Pflichtenheft vorhanden?|[F] Einreichen Bericht durch Inhaber} >]
  detailuntersuchung_laeuft [label=< {<B>Detailuntersuchung läuft</B>|[F] Abschluss Untersuchungsstufe?} >]
  detailuntersuchung_schlussbericht [label=< {<B>Detailuntersuchung Schlussbericht</B>|[F] Aufforderung zur Einreichung|[D] Brief - Aufforderung zur Einreichung Bericht|[F] Einreichen Bericht durch Inhaber} >]
  detailuntersuchung_schlussbericht_beurteilung [label=< {<B>Detailuntersuchung Schlussbericht - Beurteilung</B>|[D] Bericht Inhaber|[F] Relevante Stellungnahme Kanton?|[D] Stellungnahme Kanton|[F] Beurteilung abgeschlossen?|[F] Neubeurteilung Standort nötig|[F] Ergänzende Detailuntersuchung} >]
  du_pflichtenheft_mahnung [label=< {<B>DU Pflichtenheft - Mahnung zur Einreichung</B>|[D] Brief - Mahnung an Inhaber|[F] Reaktion Inhaber auf Mahnung} >]
  du_pflichtenheft_beurteilung [label=< {<B>DU Pflichtenheft - Beurteilung</B>|[D] Pflichtenheft Inhaber|[F] Relevante Stellungnahme Kanton?|[D] Stellungnahme Kanton|[F] Beurteilung abgeschlossen?|[F] Beurteilung Versand - Brief vollständig?} >]
  END [label=< {<B>__END__</B>} >]
  du_pflichtenheft_anhoerung_inhaber [label=< {<B>DU Pflichtenheft - Anhörung Inhaber</B>|[D] Brief - Stellungnahme definitiv|[F] Eingang Stellungnahme abwarten|[D] Stellungnahme Inhaber *|[F] Einfluss Stellungnahme *|[D] Rückmeldung auf Stellungnahme *|[F] Dokumentaufnahme *} >]
  detailuntersuchung_freigabe_durch [label=< {<B>Detailuntersuchung - Freigabe</B>|[F] Pflichtenheft bewilligt} >]
  sanierung_start_sanierungsprojekt [label=< {<B>Sanierung - Start Sanierungsprojekt</B>|[F] Aufforderung zur Einreichung|[D] Brief - Aufforderung zur Einreichung Bericht|[F] Einreichen Bericht durch Inhaber} >]
  detailuntersuchung_schlussbericht_mahnung [label=< {<B>Detailuntersuchung Schlussbericht - Mahnung Bericht</B>|[D] Brief - Mahnung an Inhaber|[F] Reaktion Inhaber auf Mahnung} >]
  start_ergaenzende_du [label=< {<B>Start ergänzende DU</B>|[F] Sanierungsuntersuchung|[D] Pflichtenheft Inhaber} >]
  erg_du_pflichtenheft_mahnung_bericht [label=< {<B>Erg. DU Pflichtenheft - Mahnung Bericht</B>|[D] Brief - Mahnung an Inhaber|[F] Reaktion Inhaber auf Mahnung} >]
  ergaenzende_du_pflichtenheft [label=< {<B>Ergänzende DU - Pflichtenheft</B>|[F] Aufforderung zur Einreichung|[D] Brief - Aufforderung zur Einreichung Bericht|[F] Einreichen Bericht durch Inhaber} >]
  ergaenzende_du_pflichtenheft_beurteilung [label=< {<B>Ergänzende DU Pflichtenheft - Beurteilung</B>|[D] Pflichtenheft Inhaber|[F] Relevante Stellungnahme Kanton?|[D] Stellungnahme Kanton|[F] Beurteilung abgeschlossen?} >]
  ergaenzende_du_pflichtenheft_anhoerung_inhaber [label=< {<B>Ergänzende DU Pflichtenheft - Anhörung Inhaber</B>|[D] Brief - Stellungnahme definitiv|[F] Eingang Stellungnahme abwarten|[D] Stellungnahme Inhaber|[F] Einfluss Stellungnahme|[D] Rückmeldung auf Stellungnahme|[F] Dokumentaufnahme} >]
  ergaenzende_du_freigabe_durch [label=< {<B>Ergänzende DU - Freigabe</B>|[F] Pflichtenheft bewilligt} >]
  ergaenzende_detailuntersuchung_lauft [label=< {<B>Ergänzende Detailuntersuchung läuft</B>|[F] Abschluss Untersuchungsstufe?} >]
  erg_detailuntersuchung_schlussbericht_beurteilung [label=< {<B>Erg. Detailuntersuchung Schlussbericht - Beurteilung</B>|[D] Schlussbericht Inhaber|[F] Relevante Stellungnahme Kanton?|[D] Stellungnahme Kanton|[F] Beurteilung abgeschlossen?|[F] Neubeurteilung Standort nötig} >]
  sanierungsprojekt_mahnung_zur_einreichung [label=< {<B>Sanierungsprojekt - Mahnung zur Einreichung</B>|[D] Brief - Mahnung an Inhaber|[F] Reaktion Inhaber auf Mahnung} >]
  sanierungsprojekt_beurteilung [label=< {<B>Sanierungsprojekt - Beurteilung</B>|[D] Bericht Inhaber|[F] Relevante Stellungnahme Kanton?|[D] Stellungnahme Kanton|[F] Beurteilung abgeschlossen?|[F] Beurteilung Versand - Brief vollständig?} >]
  sanierungsprojekt_anhoerung_kanton [label=< {<B>Sanierungsprojekt - Anhörung Kanton</B>|[D] Brief - Begleitbrief Anhörung Behörde|[F] Eingang Stellungnahme abwarten|[D] Stellungnahme Kanton|[F] Einfluss Stellungnahme|[D] Rückmeldung auf Stellungnahme|[F] Dokumentaufnahme} >]
  sanierungsprojekt_anhoerung_inhaber [label=< {<B>Sanierungsprojekt - Anhörung Inhaber</B>|[D] Brief - Stellungnahme definitiv|[F] Eingang Stellungnahme abwarten|[D] Stellungnahme Inhaber|[F] Einfluss Stellungnahme|[D] Rückmeldung auf Stellungnahme|[F] Dokumentaufnahme} >]
  standortsanierung_freigabe_durch [label=< {<B>Standortsanierung - Freigabe</B>|[F] Pflichtenheft bewilligt} >]
  standortsanierung_laeuft_zwischenbericht [label=< {<B>Standortsanierung läuft - Zwischenbericht</B>|[F] Zwischenberichte?|[D] Bericht Inhaber|[D] Nachfrage beim Inhaber nach Bericht|[F] Dokumentaufnahme} >]
  standortsanierung_laeuft_mahnung_bericht [label=< {<B>Standortsanierung läuft - Mahnung Bericht</B>|[D] Brief - Mahnung an Inhaber|[F] Reaktion Inhaber auf Mahnung} >]
  standortsanierung_laeuft_beurteilung_zwischenbericht [label=< {<B>Standortsanierung läuft - Beurteilung Zwischenbericht</B>|[F] Stellungnahme erforderlich?|[F] Beurteilung Versand - Brief vollständig?|[D] Brief - Stellungnahme definitiv|[F] Dokumentaufnahme} >]
  standortsanierung_lauft [label=< {<B>Standortsanierung läuft</B>|[F] Abschluss Untersuchungsstufe?} >]
  erfolgskontrolle [label=< {<B>Erfolgskontrolle</B>|[F] Bericht zur Neubeurteilung nach Sanierung|[D] Schlussbericht Inhaber|[F] Dokumentaufnahme} >]
  erfolgskontrolle_mahnung_schlussbericht [label=< {<B>Erfolgskontrolle - Mahnung Schlussbericht</B>|[D] Brief - Mahnung an Inhaber|[F] Reaktion Inhaber auf Mahnung|[D] Schlussbericht Inhaber|[F] Dokumentaufnahme} >]
  erfolgskontrolle_beurteilung_schlussbericht [label=< {<B>Erfolgskontrolle - Beurteilung Schlussbericht</B>|[F] Relevante Stellungnahme Kanton?|[D] Stellungnahme Kanton|[F] Beurteilung abgeschlossen?|[F] Stellungnahme zu Erfolgskontrolle oder Neubeurteilung?|[F] Beurteilung Versand - Brief vollständig?} >]
  erfolgskontrolle_anhoerung_inhaber [label=< {<B>Erfolgskontrolle - Anhörung Inhaber</B>|[D] Brief - Stellungnahme definitiv|[F] Eingang Stellungnahme abwarten|[D] Stellungnahme Inhaber|[F] Einfluss Stellungnahme|[D] Rückmeldung auf Stellungnahme|[F] Dokumentaufnahme} >]
  sanierung_ende [label=< {<B>Sanierung Ende</B>|[F] Sanierung Ende - Neubeurteilung von Inhaber akzeptiert|[F] Eintrag in BAFU Verzeichnis sanierte Standorte} >]

  start_sanierung -> detailuntersuchung_laeuft [label="form\n.pflichtenheft\n.pflichtenheft_noetig == `nein`" fontsize=10]
  start_sanierung -> du_pflichtenheft_mahnung [label="form\n.start_sanierung__einreichen_brief\n.bericht_eingereicht == `nein`" fontsize=10]
  start_sanierung -> detailuntersuchung_schlussbericht [label="form\n.zusatz_untersuchungen\n.zusatz_untersuchungen_noetig == `varianten`" fontsize=10]
  start_sanierung -> sanierung_start_sanierungsprojekt [label="form\n.zusatz_untersuchungen\n.zusatz_untersuchungen_noetig == `nein`" fontsize=10]
  start_sanierung -> du_pflichtenheft_beurteilung [label="form\n.start_sanierung__einreichen_brief\n.bericht_eingereicht == `ja`" fontsize=10]
