digraph {
  graph [label=< <B>OTaRSi Insediamento</B><BR/><BR/> > labelloc=t]
  node [shape=record]

  __START__ [label=< <B>START</B> >]
  __START__ -> abgeltung_starten
  abgeltung_starten [label=< {<B>Avvio della compensazione OTaRSi</B>|[F] Esame dei requisiti di compensazione} >]
  anhoerung [label=< {<B>Consultazione UFAM</B>|[D] Creare una richiesta di audizione} >]
  reaktion_bafu_anhoerung [label=< {<B>Risposta dell'UFAM alla consultazione</B>|[F] Risposta dell'UFAM} >]
  zusicherung [label=< {<B>Richiesta di garanzia</B>|[D] Creare una richiesta di garanzia} >]
  reaktion_bafu_zusicherung [label=< {<B>Risposta dell'UFAM alla garanzia</B>|[F] Risposta dell'UFAM} >]
  auszahlungsgesuch [label=< {<B>Domanda di pagamento all'UFAM</B>|[D] Domanda di pagamento} >]
  reaktion_bafu_auszahlungsgesuch [label=< {<B>Risposta dell'UFAM alla richiesta di pagamento</B>|[F] Risposta dell'UFAM} >]
  zahlung [label=< {<B>In attesa del pagamento da parte dell'UFAM</B>|[F] Pagamento UFAM ricevuto} >]
  auszahlung [label=< {<B>Pagamento al vero responsabile</B>|[D] Creare l'esborso ai soggetti responsabili dei benefici reali} >]
  END [label=< {<B>__END__</B>} >]

  abgeltung_starten -> anhoerung [label="form\n.pruefung_voraussetzungen\n.ueber_250000 == `ja`" fontsize=10]
  abgeltung_starten -> auszahlungsgesuch [label="form\n.pruefung_voraussetzungen\n.ueber_250000 == `nein`" fontsize=10]
  anhoerung -> reaktion_bafu_anhoerung [label="" fontsize=10]
  reaktion_bafu_anhoerung -> END [label="form\n.reaktion_anhoerung\n.antrag_bewilligt == `nein`" fontsize=10]
  reaktion_bafu_anhoerung -> zusicherung [label="form\n.reaktion_anhoerung\n.antrag_bewilligt == `ja`" fontsize=10]
  zusicherung -> reaktion_bafu_zusicherung [label="" fontsize=10]
  reaktion_bafu_zusicherung -> END [label="form\n.reaktion_zusicherung\n.antrag_bewilligt == `nein`" fontsize=10]
  reaktion_bafu_zusicherung -> auszahlungsgesuch [label="form\n.reaktion_zusicherung\n.antrag_bewilligt == `ja`" fontsize=10]
  auszahlungsgesuch -> reaktion_bafu_auszahlungsgesuch [label="" fontsize=10]
  reaktion_bafu_auszahlungsgesuch -> END [label="form\n.reaktion_auszahlungsgesuch\n.antrag_bewilligt == `nein`" fontsize=10]
  reaktion_bafu_auszahlungsgesuch -> zahlung [label="form\n.reaktion_auszahlungsgesuch\n.antrag_bewilligt == `ja`" fontsize=10]
  zahlung -> auszahlung [label="form\n.zahlung_eingetroffen\n.zahlung_eingetroffen == `ja`" fontsize=10]
  auszahlung -> END [label="" fontsize=10]
}
