digraph {
  graph [label=< <B>Esame preliminare</B><BR/><BR/> > labelloc=t]
  node [shape=record]

  __START__ [label=< <B>START</B> >]
  __START__ -> start_hu
  start_hu [label=< {<B>Presentazione del rapporto EP</B>|[F] Al proprietario è stato chiesto di presentare una relazione?|[D] Richiesta di esame preliminare|[F] Rapporto ricevuto?} >]
  mahnung_bericht_hu [label=< {<B>Promemoria per la presentazione del rapporto</B>|[D] Promemoria per il proprietario|[F] Presentazione del rapporto dopo il sollecito} >]
  beurteilung_hu [label=< {<B>Ufficio Valutazione EP</B>|[D] Rapporto ricevuto|[F] Valutazione EP Canton disponibile?|[D] Dichiarazione cantonale|[F] Valutazione EP completata|[F] Dichiarazione sull'indagine direttamente con un OP o separatamente?} >]
  anhoerung_inhaber_hu [label=< {<B>Audizione dei titolari di EP</B>|[D] Dichiarazione|[F] Opinione decisa dal proprietario all'EP?} >]
  stellungnahme_anhoerung_inhaber_hu [label=< {<B>Supporto per il cuscinetto di reazione per l'indagine principale</B>|[D] Proprietario della dichiarazione|[F] Proprietario della dichiarazione di influenza sull'ispezione principale|[D] Ufficio dichiarazioni su Titolare della dichiarazione} >]
  ergaenzung_hu [label=< {<B>IP supplementare?</B>|[F] Progressione dopo l'IP} >]
  tu_pflichtenheft [label=< {<B>Rapporto Specifiche IT</B>|[F] Rapporto ricevuto?} >]
  mahnung_tu_Pflichtenheft_bericht [label=< {<B>Promemoria per la presentazione delle specifiche del IT</B>|[D] Promemoria per il proprietario|[F] Presentazione dopo il sollecito?} >]
  beurteilung_tu_pflichtenheft [label=< {<B>Valutazione Specifiche dell'Ufficio IT</B>|[D] Rapporto ricevuto|[F] Valutazione IT Canton disponibile?|[D] Dichiarazione cantonale|[F] Valutazione IT completata} >]
  anhoerung_inhaber_tu_pflichtenheft [label=< {<B>Consultazione con i proprietari sulle specifiche del IT</B>|[D] Dichiarazione|[F] Opinione decisa proprietario alle specifiche IT?} >]
  stellungnahme_anhoerung_inhaber_tu_pflichtenheft [label=< {<B>Consultazione con i proprietari sulle specifiche del IT</B>|[D] Proprietario della dichiarazione|[F] Dichiarazione di influenza del proprietario sulle specifiche del IT|[D] Ufficio dichiarazioni su Titolare della dichiarazione} >]
  tu_bericht [label=< {<B>Rapporto IT</B>|[F] Rapporto ricevuto?} >]
  mahnung_tu_bericht [label=< {<B>Promemoria per la presentazione del rapporto IT</B>|[D] Promemoria per il proprietario|[F] Presentazione dopo il sollecito?} >]
  beurteilung_tu [label=< {<B>Valutazione IT</B>|[D] Rapporto ricevuto|[F] Valutazione IT Canton disponibile?|[D] Dichiarazione cantonale|[F] Valutazione IT completata|[F] Dichiarazione sull'indagine direttamente con un OP o separatamente?} >]
  anhoerung_inhaber_tu [label=< {<B>Consultazione Proprietario su IT</B>|[D] Dichiarazione|[F] Opinione decisa proprietario a IT?} >]
  stellungnahme_anhoerung_inhaber_tu [label=< {<B>Proprietario dell'audizione di reazione a IT</B>|[D] Proprietario della dichiarazione|[F] Dichiarazione di influenza del proprietario su IT|[D] Ufficio dichiarazioni su Titolare della dichiarazione} >]
  ergaenzung_tu [label=< {<B>Progressione secondo il IT</B>|[F] È necessario un IT supplementare?} >]
  abschluss_tu [label=< {<B>IT completato</B>|[F] IT completato} >]
  abschluss [label=< {<B>Completata l'indagine preliminare</B>|[F] IT completato} >]
  END [label=< {<B>__END__</B>} >]

  start_hu -> beurteilung_hu [label="form\n.entscheid_bericht_hu\n.entscheid_bericht_hu_erfasst == `ja`" fontsize=10]
  start_hu -> mahnung_bericht_hu [label="form\n.entscheid_bericht_hu\n.entscheid_bericht_hu_erfasst == `nein`" fontsize=10]
  mahnung_bericht_hu -> beurteilung_hu [label="form\n.entscheid_bericht_hu_mahnung\n.entscheid_bericht_hu_mahnung_erfasst == `ja`" fontsize=10]
  mahnung_bericht_hu -> mahnung_bericht_hu [label="form\n.entscheid_bericht_hu_mahnung\n.entscheid_bericht_hu_mahnung_erfasst == `nein`" fontsize=10]
  beurteilung_hu -> anhoerung_inhaber_hu [label="form\n.entscheid_beurteilung_hu_iho\n.entscheid_beurteilung_hu_iho_erfasst == `ja`" fontsize=10]
  beurteilung_hu -> ergaenzung_hu [label="form\n.entscheid_beurteilung_hu_iho\n.entscheid_beurteilung_hu_iho_erfasst == `nein`" fontsize=10]
  anhoerung_inhaber_hu -> stellungnahme_anhoerung_inhaber_hu [label="form\n.entscheid_stellungnahme_inhaber_hu\n.entscheid_stellungnahme_inhaber_hu_erfasst == `ja`" fontsize=10]
  anhoerung_inhaber_hu -> ergaenzung_hu [label="form\n.entscheid_stellungnahme_inhaber_hu\n.entscheid_stellungnahme_inhaber_hu_erfasst == `nein`" fontsize=10]
  stellungnahme_anhoerung_inhaber_hu -> ergaenzung_hu [label="form\n.entscheid_einfluss_stellungnahme_inhaber_hu\n.entscheid_einfluss_stellungnahme_inhaber_hu_erfasst == `einverstanden` || form\n.entscheid_einfluss_stellungnahme_inhaber_hu\n.entscheid_einfluss_stellungnahme_inhaber_hu_erfasst == 'keine'" fontsize=10]
  stellungnahme_anhoerung_inhaber_hu -> stellungnahme_anhoerung_inhaber_hu [label="form\n.entscheid_einfluss_stellungnahme_inhaber_hu\n.entscheid_einfluss_stellungnahme_inhaber_hu_erfasst == `abgelehnt`" fontsize=10]
  stellungnahme_anhoerung_inhaber_hu -> beurteilung_hu [label="form\n.entscheid_einfluss_stellungnahme_inhaber_hu\n.entscheid_einfluss_stellungnahme_inhaber_hu_erfasst == `neubeurteilung`" fontsize=10]
  ergaenzung_hu -> abschluss [label="form\n.entscheid_verlauf_nach_hu\n.entscheid_verlauf_nach_hu_erfasst == `abschluss`" fontsize=10]
  ergaenzung_hu -> tu_pflichtenheft [label="form\n.entscheid_verlauf_nach_hu\n.entscheid_verlauf_nach_hu_erfasst == `tu_pflichtenheft`" fontsize=10]
  ergaenzung_hu -> tu_bericht [label="form\n.entscheid_verlauf_nach_hu\n.entscheid_verlauf_nach_hu_erfasst == `tu`" fontsize=10]
  ergaenzung_hu -> start_hu [label="form\n.entscheid_verlauf_nach_hu\n.entscheid_verlauf_nach_hu_erfasst == `hu`" fontsize=10]
  tu_pflichtenheft -> beurteilung_tu_pflichtenheft [label="form\n.entscheid_bericht_tu_ph\n.entscheid_bericht_tu_ph_erfasst == `ja`" fontsize=10]
  tu_pflichtenheft -> mahnung_tu_Pflichtenheft_bericht [label="form\n.entscheid_bericht_tu_ph\n.entscheid_bericht_tu_ph_erfasst == `nein`" fontsize=10]
  mahnung_tu_Pflichtenheft_bericht -> beurteilung_tu_pflichtenheft [label="form\n.entscheid_mahnung_tu_ph\n.entscheid_mahnung_tu_ph_erfasst == `ja`" fontsize=10]
  mahnung_tu_Pflichtenheft_bericht -> mahnung_tu_Pflichtenheft_bericht [label="form\n.entscheid_mahnung_tu_ph\n.entscheid_mahnung_tu_ph_erfasst == `nein`" fontsize=10]
  beurteilung_tu_pflichtenheft -> anhoerung_inhaber_tu_pflichtenheft [label="" fontsize=10]
  anhoerung_inhaber_tu_pflichtenheft -> stellungnahme_anhoerung_inhaber_tu_pflichtenheft [label="form\n.entscheid_stellungnahme_inhaber_tu_pflichtenheft\n.entscheid_stellungnahme_inhaber_tu_pflichtenheft_erfasst == `ja`" fontsize=10]
  anhoerung_inhaber_tu_pflichtenheft -> tu_bericht [label="form\n.entscheid_stellungnahme_inhaber_tu_pflichtenheft\n.entscheid_stellungnahme_inhaber_tu_pflichtenheft_erfasst == `nein`" fontsize=10]
  stellungnahme_anhoerung_inhaber_tu_pflichtenheft -> tu_bericht [label="form\n.entscheid_einfluss_stellungnahme_inhaber_tu_pflichtenheft\n.entscheid_einfluss_stellungnahme_inhaber_tu_pflichtenheft_erfasst == `einverstanden` || form\n.entscheid_einfluss_stellungnahme_inhaber_tu_pflichtenheft\n.entscheid_einfluss_stellungnahme_inhaber_tu_pflichtenheft_erfasst == 'keine'" fontsize=10]
  stellungnahme_anhoerung_inhaber_tu_pflichtenheft -> stellungnahme_anhoerung_inhaber_tu_pflichtenheft [label="form\n.entscheid_einfluss_stellungnahme_inhaber_tu_pflichtenheft\n.entscheid_einfluss_stellungnahme_inhaber_tu_pflichtenheft_erfasst == `abgelehnt`" fontsize=10]
  stellungnahme_anhoerung_inhaber_tu_pflichtenheft -> beurteilung_tu_pflichtenheft [label="form\n.entscheid_einfluss_stellungnahme_inhaber_tu_pflichtenheft\n.entscheid_einfluss_stellungnahme_inhaber_tu_pflichtenheft_erfasst == `neubeurteilung`" fontsize=10]
  tu_bericht -> beurteilung_tu [label="form\n.entscheid_bericht_tu\n.entscheid_bericht_tu_erfasst == `ja`" fontsize=10]
  tu_bericht -> mahnung_tu_bericht [label="form\n.entscheid_bericht_tu\n.entscheid_bericht_tu_erfasst == `nein`" fontsize=10]
  mahnung_tu_bericht -> beurteilung_tu [label="form\n.entscheid_mahnung_tu\n.entscheid_mahnung_tu_erfasst == `ja`" fontsize=10]
  mahnung_tu_bericht -> mahnung_tu_bericht [label="form\n.entscheid_mahnung_tu\n.entscheid_mahnung_tu_erfasst == `nein`" fontsize=10]
  beurteilung_tu -> anhoerung_inhaber_tu [label="form\n.entscheid_beurteilung_tu_iho\n.entscheid_beurteilung_tu_iho_erfasst == `ja`" fontsize=10]
  beurteilung_tu -> ergaenzung_tu [label="form\n.entscheid_beurteilung_tu_iho\n.entscheid_beurteilung_tu_iho_erfasst == `nein`" fontsize=10]
  anhoerung_inhaber_tu -> stellungnahme_anhoerung_inhaber_tu [label="form\n.entscheid_stellungnahme_inhaber_tu\n.entscheid_stellungnahme_inhaber_tu_erfasst == `ja`" fontsize=10]
  anhoerung_inhaber_tu -> ergaenzung_tu [label="form\n.entscheid_stellungnahme_inhaber_tu\n.entscheid_stellungnahme_inhaber_tu_erfasst == `nein`" fontsize=10]
  stellungnahme_anhoerung_inhaber_tu -> ergaenzung_tu [label="form\n.entscheid_einfluss_stellungnahme_inhaber_tu\n.entscheid_einfluss_stellungnahme_inhaber_tu_erfasst == `einverstanden` || form\n.entscheid_einfluss_stellungnahme_inhaber_tu\n.entscheid_einfluss_stellungnahme_inhaber_tu_erfasst == 'keine'" fontsize=10]
  stellungnahme_anhoerung_inhaber_tu -> stellungnahme_anhoerung_inhaber_tu [label="form\n.entscheid_einfluss_stellungnahme_inhaber_tu\n.entscheid_einfluss_stellungnahme_inhaber_tu_erfasst == `abgelehnt`" fontsize=10]
  stellungnahme_anhoerung_inhaber_tu -> beurteilung_tu [label="form\n.entscheid_einfluss_stellungnahme_inhaber_tu\n.entscheid_einfluss_stellungnahme_inhaber_tu_erfasst == `neubeurteilung`" fontsize=10]
  ergaenzung_tu -> abschluss_tu [label="form\n.entscheid_verlauf_nach_tu\n.entscheid_verlauf_nach_tu_erfasst == `nein`" fontsize=10]
  ergaenzung_tu -> beurteilung_tu [label="form\n.entscheid_verlauf_nach_tu\n.entscheid_verlauf_nach_tu_erfasst == `ja`" fontsize=10]
  ergaenzung_tu -> beurteilung_tu_pflichtenheft [label="form\n.entscheid_verlauf_nach_tu\n.entscheid_verlauf_nach_tu_erfasst == `tu_pflichtenheft`" fontsize=10]
  abschluss_tu -> abschluss [label="" fontsize=10]
  abschluss -> END [label="" fontsize=10]
}
