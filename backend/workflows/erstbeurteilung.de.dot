digraph {
  graph [label=< <B>Erstbeurteilung Inhaberorientierung</B><BR/><BR/> > labelloc=t]
  node [shape=record]

  __START__ [label=< <B>START</B> >]
  __START__ -> start_erstbeurteilung
  start_erstbeurteilung [label=< {<B>Erstbeurteilung Erhebungsdokumente</B>|[D] Erhebungsdokumente|[F] Erhebungsdokumente vollständig erfasst?} >]
  kontrolle_standortdaten [label=< {<B>Kontolle Standortsdaten und Beurteilung</B>|[F] Standortsdaten und Beurteilung erfasst?} >]
  anhoerung_kanton [label=< {<B>Vorbereitung Anhörung Kanton</B>|[F] Entwurf vollständig erfasst?|[F] Kontrolle Entwurf Anhörung Kanton|[F] Entwurf zu Anhörung Kanton zum Versand freigeben} >]
  versand_anhoerung_kanton [label=< {<B>Versand Anhörung Kanton</B>|[D] Begleitbrief zu Anhörung Kanton|[F] Datenabgabe digital|[F] Eingang Stellungnahme Kanton} >]
  stellungnahme_anhoerung_kanton [label=< {<B>Reaktion Stellungnahme Anhörung Kanton</B>|[F] Einfluss Stellungnahme Kanton|[D] Rückmeldung zur Stellungnahme|[F] Dokumentenaufnahme|[D] Stellungnahme Kanton} >]
  inhaberorientierung [label=< {<B>Vorbereitung Inhaberorientierung</B>|[F] Entscheid Inhaberorientierung vollständig erfasst?|[F] Kontrolle Entscheid Inhaberorientierung|[F] Entscheid Inhaberorientierung zum Versand freigeben} >]
  versand_iho_ersteintrag [label=< {<B>Versand Inhaberorientierung Ersteintrag</B>|[D] Inhaberorientierungsbrief|[F] Datenabgabe digital|[F] Eingang Stellungnahme Inhaber} >]
  ersteintrag [label=< {<B>rechtskräftiger Ersteintrag im Kataster</B>|[F] Rechtskräftiger Ersteintrag} >]
  stellungnahme_inhaber [label=< {<B>Reaktion Stellungnahme Inhaber</B>|[D] Stellungnahme Inhaber|[F] Einfluss Stellungnahme Inhaber|[D] Rückmeldung zur Stellungnahme|[F] Dokumentenaufnahme} >]
  versand_iho_nichteintrag [label=< {<B>Versand Inhaberorientierung Nichteintrag</B>|[D] Inhaberorientierungsbrief|[F] Datenabgabe digital|[F] Eingang Stellungnahme Inhaber} >]
  stellungnahme_inhaber_nichteintrag [label=< {<B>Reaktion Stellungnahme Inhaber Nichteintrag</B>|[D] Stellungnahme Inhaber|[F] Einfluss Stellungnahme Inhaber|[D] Rückmeldung zur Stellungnahme|[F] Dokumentenaufnahme} >]
  nichteintrag [label=< {<B>Nichteintrag definitiv</B>|[F] Abschluss Erstbeurteilung} >]
  feststellungsverfuegung [label=< {<B>Versand Feststellungsverfügung</B>|[D] Feststellungsverfügung|[F] Anfechtung Feststellungsverfügung} >]
  feststellungsverfuegung_anfechtung [label=< {<B>Anfechtung Feststellungsverfügung</B>|[D] Anfechtung Feststellungsverfügung|[F] Entscheid zur Anfechtung Feststellungsverfügung} >]
  END [label=< {<B>__END__</B>} >]

  start_erstbeurteilung -> kontrolle_standortdaten [label="" fontsize=10]
  kontrolle_standortdaten -> anhoerung_kanton [label="" fontsize=10]
  anhoerung_kanton -> versand_anhoerung_kanton [label="" fontsize=10]
  versand_anhoerung_kanton -> stellungnahme_anhoerung_kanton [label="form\n.entscheid_stellungnahme_ah\n.entscheid_stellungnahme_ah_erfasst == `ja`" fontsize=10]
  versand_anhoerung_kanton -> inhaberorientierung [label="form\n.entscheid_stellungnahme_ah\n.entscheid_stellungnahme_ah_erfasst == `nein`" fontsize=10]
  stellungnahme_anhoerung_kanton -> stellungnahme_anhoerung_kanton [label="form\n.entscheid_stellungnahme_kanton\n.entscheid_stellungnahme_kanton_erfasst == `abgewiesen`" fontsize=10]
  stellungnahme_anhoerung_kanton -> inhaberorientierung [label="form\n.entscheid_stellungnahme_kanton\n.entscheid_stellungnahme_kanton_erfasst == `einverstanden` || form\n.entscheid_stellungnahme_kanton\n.entscheid_stellungnahme_kanton_erfasst == `ignoriert`" fontsize=10]
  stellungnahme_anhoerung_kanton -> kontrolle_standortdaten [label="form\n.entscheid_stellungnahme_kanton\n.entscheid_stellungnahme_kanton_erfasst == `neu`" fontsize=10]
  inhaberorientierung -> versand_iho_ersteintrag [label="vflz\n.belastet == `true`" fontsize=10]
  inhaberorientierung -> versand_iho_nichteintrag [label="vflz\n.belastet == `false`" fontsize=10]
  versand_iho_ersteintrag -> stellungnahme_inhaber [label="form\n.entscheid_stellungnahme_iho\n.entscheid_stellungnahme_iho_erfasst == `ja`" fontsize=10]
  versand_iho_ersteintrag -> ersteintrag [label="form\n.entscheid_stellungnahme_iho\n.entscheid_stellungnahme_iho_erfasst == `nein`" fontsize=10]
  versand_iho_ersteintrag -> feststellungsverfuegung [label="form\n.entscheid_stellungnahme_iho\n.entscheid_stellungnahme_iho_erfasst == `feststellungsverfuegung`" fontsize=10]
  ersteintrag -> END [label="" fontsize=10]
  stellungnahme_inhaber -> ersteintrag [label="form\n.entscheid_stellungnahme_inhaber\n.entscheid_stellungnahme_inhaber_erfasst == `ignoriert` || form\n.entscheid_stellungnahme_inhaber\n.entscheid_stellungnahme_inhaber_erfasst == `einverstanden`" fontsize=10]
  stellungnahme_inhaber -> kontrolle_standortdaten [label="form\n.entscheid_stellungnahme_inhaber\n.entscheid_stellungnahme_inhaber_erfasst == `neu`" fontsize=10]
  stellungnahme_inhaber -> stellungnahme_inhaber [label="form\n.entscheid_stellungnahme_inhaber\n.entscheid_stellungnahme_inhaber_erfasst == `abgewiesen`" fontsize=10]
  stellungnahme_inhaber -> feststellungsverfuegung [label="form\n.entscheid_stellungnahme_inhaber\n.entscheid_stellungnahme_inhaber_erfasst == `feststellungsverfuegung`" fontsize=10]
  versand_iho_nichteintrag -> stellungnahme_inhaber_nichteintrag [label="form\n.entscheid_stellungnahme_iho_nichteintrag\n.entscheid_stellungnahme_iho_nichteintrag_erfasst == `ja`" fontsize=10]
  versand_iho_nichteintrag -> nichteintrag [label="form\n.entscheid_stellungnahme_iho_nichteintrag\n.entscheid_stellungnahme_iho_nichteintrag_erfasst == `nein`" fontsize=10]
  versand_iho_nichteintrag -> feststellungsverfuegung [label="form\n.entscheid_stellungnahme_iho_nichteintrag\n.entscheid_stellungnahme_iho_nichteintrag_erfasst == `feststellungsverfuegung`" fontsize=10]
  stellungnahme_inhaber_nichteintrag -> nichteintrag [label="form\n.entscheid_stellungnahme_inhaber_nichteintrag\n.entscheid_stellungnahme_inhaber_nichteintrag_erfasst == `ignoriert` || form\n.entscheid_stellungnahme_inhaber_nichteintrag\n.entscheid_stellungnahme_inhaber_nichteintrag_erfasst == `einverstanden`" fontsize=10]
  stellungnahme_inhaber_nichteintrag -> kontrolle_standortdaten [label="form\n.entscheid_stellungnahme_inhaber_nichteintrag\n.entscheid_stellungnahme_inhaber_nichteintrag_erfasst == `neu`" fontsize=10]
  stellungnahme_inhaber_nichteintrag -> stellungnahme_inhaber_nichteintrag [label="form\n.entscheid_stellungnahme_inhaber_nichteintrag\n.entscheid_stellungnahme_inhaber_nichteintrag_erfasst == `abgewiesen`" fontsize=10]
  stellungnahme_inhaber_nichteintrag -> feststellungsverfuegung [label="form\n.entscheid_stellungnahme_inhaber_nichteintrag\n.entscheid_stellungnahme_inhaber_nichteintrag_erfasst == `feststellungsverfuegung`" fontsize=10]
  nichteintrag -> END [label="" fontsize=10]
  feststellungsverfuegung -> feststellungsverfuegung_anfechtung [label="form\n.entscheid_feststellungsverfuegung\n.entscheid_feststellungsverfuegung_erfasst == `ja`" fontsize=10]
  feststellungsverfuegung -> ersteintrag [label="form\n.entscheid_feststellungsverfuegung\n.entscheid_feststellungsverfuegung_erfasst == `nein`" fontsize=10]
  feststellungsverfuegung_anfechtung -> kontrolle_standortdaten [label="form\n.entscheid_feststellungsverfuegung_anfechtung\n.entscheid_feststellungsverfuegung_anfechtung_erfasst == `neu`" fontsize=10]
  feststellungsverfuegung_anfechtung -> ersteintrag [label="form\n.entscheid_feststellungsverfuegung_anfechtung\n.entscheid_feststellungsverfuegung_anfechtung_erfasst == `ersteintrag`" fontsize=10]
}
