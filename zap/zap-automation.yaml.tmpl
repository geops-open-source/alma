env:
  contexts:
    - name: alma
      urls:
        - ${ZAP_TARGET}
      includePaths:
        - ${ZAP_TARGET}.*
      excludePaths:
        - ${ZAP_TARGET}/auth/.*        # Keycloak itself
        - ${ZAP_TARGET}/api/auth/logout/
      authentication:
        method: form
        parameters:
          loginPageUrl: ${ZAP_TARGET}/api/auth/authorize/
          loginRequestData: "username={%username%}&password={%password%}"
          usernameParameter: username
          passwordParameter: password
        verification:
          method: response
          loggedOutRegex: "auth/realms/alma"
          pollFrequency: 60
          pollUnits: requests
      sessionManagement:
        method: cookie
        parameters:
          cookieName: session
      users:
        - name: admin
          credentials:
            username: "${ZAP_USERNAME}"
            password: "${ZAP_PASSWORD}"
        - name: regular_user
          credentials:
            username: "${ZAP_USERNAME_REGULAR}"
            password: "${ZAP_PASSWORD_REGULAR}"

jobs:
  - type: passiveScan-config
    parameters:
      maxAlertsPerRule: 0
      scanOnlyInScope: true

  - type: openapi
    parameters:
      apiFile: /zap/wrk/openapi.json
      context: alma
      targetUrl: ${ZAP_TARGET}

  # Traditional spider
  - type: spider
    parameters:
      context: alma
      user: admin
      maxDuration: ${spiderDuration}
      maxDepth: 10
      maxChildren: 0

  # AJAX spider for JS-rendered content (SPA)
  - type: spiderAjax
    parameters:
      context: alma
      user: admin
      maxDuration: ${ajaxDuration}
      browserId: firefox-headless
      runOnlyIfModern: false

  - type: passiveScan-wait
    parameters:
      maxDuration: ${passiveWaitDuration}

  # Active scan as admin
  - type: activeScan
    parameters:
      context: alma
      user: admin
      threadPerHost: 5
      delayInMs: 0
      maxRuleDurationInMins: ${ruleDuration}
      maxScanDurationInMins: ${scanDuration}
      addQueryParam: true
      handleAntiCSRFTokens: true
      injectPluginIdInHeader: false

  # Active scan as regular user (catches IDOR / privilege escalation)
  - type: activeScan
    parameters:
      context: alma
      user: regular_user
      threadPerHost: 5
      delayInMs: 0
      maxRuleDurationInMins: ${ruleDuration}
      maxScanDurationInMins: ${scanDuration}
      addQueryParam: true
      handleAntiCSRFTokens: true
      injectPluginIdInHeader: false

  - type: report
    parameters:
      template: sarif-json
      reportFile: /zap/wrk/reports/zap-report.sarif.json

  - type: report
    parameters:
      template: traditional-html
      reportFile: /zap/wrk/reports/zap-report.html
