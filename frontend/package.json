{
  "name": "frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "cypress:open": "CYPRESS_BASE_URL=http://localhost:8080 cypress open",
    "cypress:run": "cypress run --component && cypress run",
    "cypress:run:component": " cypress run --component",
    "cypress:run:e2e": "cypress run --browser chrome --headed --no-runner-ui",
    "dev": "next dev --webpack",
    "build": "next build --webpack && next-nginx-routes && node lib/generateVersionFile.mjs",
    "start": "next start",
    "lint": "eslint .",
    "codegen": "graphql-codegen",
    "format": "prettier --write .",
    "tsc": "tsc",
    "husky:setup": "cd .. && husky frontend/.husky",
    "updeps": "pnpm up --latest --interactive"
  },
  "dependencies": {
