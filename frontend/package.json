    "@dnd-kit/utilities": "^3.2.2",
    "@headlessui/react": "^2.2.10",
    "@sentry/cli": "^3.6.2",
    "@sentry/nextjs": "^10.69.0",
    "@tanstack/react-table": "^8.21.3",
    "dompurify": "^3.4.13",
    "graphql-request": "^5.2.0",
    "lodash": "^4.18.1",
    "next": "16.2.10",
    "ol": "^10.9.0",
    "ole": "link:packages/ole",
    "proj4": "^2.21.0",
    "react": "^19.2.8",
    "react-datepicker": "^9.1.0",
